# ─── The Harvester Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your API keys.

# AI Extraction Engines (at least one required)
GROQ_API_KEY=gsk_your_groq_api_key_here
CEREBRAS_API_KEY=cerebras_your_key_here
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key_here

# Google Search & Phone Verification (Optional, but recommended)
SERPAPI_KEY=your_serpapi_key_here
NUMVERIFY_KEY=your_numverify_key_here
